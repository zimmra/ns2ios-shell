     if fh not in ('on', 'off'): sys.exit(f'{g.id}: fps_hold must be on or off: {fh}')
+    utp = g.get('ue_texture_pool', '0')   # Profile-backed Unreal texture pool in MB; iOS opts in through DM_UE_TEXTURE_POOL.
